diff --git a/codex-rs/tui/src/chatwidget/status_provider.rs b/codex-rs/tui/src/chatwidget/status_provider.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dcd80936f05d5c47404887cdcfadb9386b2b3f7d
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/status_provider.rs
@@ -0,0 +1,211 @@
+//! Session-aware scheduling for the asynchronous TUI status provider.
+
+use std::time::Instant;
+
+use codex_config::types::TuiStatusProviderConfig;
+use codex_protocol::ThreadId;
+use serde::Serialize;
+use tokio::task::JoinHandle;
+
+use super::ChatWidget;
+use crate::app_event::AppEvent;
+use crate::status_provider::RuntimeStatusProviderConfig;
+use crate::status_provider::StatusProviderRunResult;
+use crate::status_provider::diagnostic_result;
+use crate::status_provider::run_status_provider;
+
+#[derive(Debug)]
+pub(super) struct StatusProviderState {
+    config: Option<RuntimeStatusProviderConfig>,
+    task: Option<JoinHandle<()>>,
+    request_id: u64,
+    next_refresh_at: Option<Instant>,
+    refresh_pending: bool,
+}
+
+impl StatusProviderState {
+    pub(super) fn new(config: Option<TuiStatusProviderConfig>) -> Self {
+        Self {
+            config: config.map(RuntimeStatusProviderConfig::from),
+            task: None,
+            request_id: 0,
+            next_refresh_at: None,
+            refresh_pending: false,
+        }
+    }
+
+    fn enabled(&self) -> bool {
+        self.config.is_some()
+    }
+
+    fn abort(&mut self) -> Option<JoinHandle<()>> {
+        let task = self.task.take();
+        if let Some(task) = task.as_ref() {
+            task.abort();
+        }
+        self.next_refresh_at = None;
+        self.refresh_pending = false;
+        task
+    }
+}
+
+impl Drop for StatusProviderState {
+    fn drop(&mut self) {
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+}
+
+#[derive(Debug, Serialize)]
+struct StatusProviderContext<'a> {
+    session_id: String,
+    cwd: &'a str,
+    workspace: StatusProviderWorkspace<'a>,
+    model: StatusProviderModel<'a>,
+    reasoning_effort: Option<&'a str>,
+}
+
+#[derive(Debug, Serialize)]
+struct StatusProviderWorkspace<'a> {
+    current_dir: &'a str,
+}
+
+#[derive(Debug, Serialize)]
+struct StatusProviderModel<'a> {
+    id: &'a str,
+    display_name: &'a str,
+}
+
+impl ChatWidget {
+    pub(super) fn restart_status_provider(&mut self) {
+        let previous_task = self.status_provider.abort();
+        self.bottom_pane.set_status_provider_lines(Vec::new());
+        self.start_status_provider_refresh_after(previous_task);
+    }
+
+    pub(super) fn request_status_provider_refresh(&mut self) {
+        if !self.status_provider.enabled() || self.thread_id.is_none() {
+            return;
+        }
+        if self.status_provider.task.is_some() {
+            self.status_provider.refresh_pending = true;
+            return;
+        }
+        self.status_provider.next_refresh_at = Some(Instant::now());
+        self.refresh_status_provider_if_due();
+    }
+
+    pub(super) fn refresh_status_provider_if_due(&mut self) {
+        let due = self
+            .status_provider
+            .next_refresh_at
+            .is_some_and(|next_refresh_at| Instant::now() >= next_refresh_at);
+        if due && self.status_provider.task.is_none() {
+            self.start_status_provider_refresh();
+        }
+    }
+
+    fn start_status_provider_refresh(&mut self) {
+        self.start_status_provider_refresh_after(/*previous_task*/ None);
+    }
+
+    fn start_status_provider_refresh_after(&mut self, previous_task: Option<JoinHandle<()>>) {
+        let Some(config) = self.status_provider.config.clone() else {
+            return;
+        };
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        if self.status_provider.task.is_some() {
+            self.status_provider.refresh_pending = true;
+            return;
+        }
+
+        self.status_provider.next_refresh_at = None;
+        if config.command.first().is_none_or(String::is_empty) {
+            self.bottom_pane.set_status_provider_lines(
+                diagnostic_result("Status provider command is empty".to_string()).lines,
+            );
+            return;
+        }
+
+        let cwd = self
+            .current_cwd
+            .as_deref()
+            .unwrap_or_else(|| self.config.cwd.as_path())
+            .to_path_buf();
+        let cwd_display = cwd.display().to_string();
+        let model = self.current_model().to_string();
+        let reasoning_effort = self
+            .effective_reasoning_effort()
+            .map(|effort| effort.as_str().to_string());
+        let context = StatusProviderContext {
+            session_id: thread_id.to_string(),
+            cwd: &cwd_display,
+            workspace: StatusProviderWorkspace {
+                current_dir: &cwd_display,
+            },
+            model: StatusProviderModel {
+                id: &model,
+                display_name: &model,
+            },
+            reasoning_effort: reasoning_effort.as_deref(),
+        };
+        let input = match serde_json::to_vec(&context) {
+            Ok(input) => input,
+            Err(err) => {
+                self.bottom_pane.set_status_provider_lines(
+                    diagnostic_result(format!("Status provider input failed: {err}")).lines,
+                );
+                return;
+            }
+        };
+
+        let request_id = self.status_provider.request_id;
+        self.status_provider.request_id = request_id.wrapping_add(1);
+        let app_event_tx = self.app_event_tx.clone();
+        let task = tokio::spawn(async move {
+            if let Some(previous_task) = previous_task {
+                let _ = previous_task.await;
+            }
+            let result =
+                run_status_provider(&config, &cwd, &input, &model, reasoning_effort.as_deref())
+                    .await;
+            app_event_tx.send(AppEvent::StatusProviderFinished {
+                thread_id,
+                request_id,
+                result,
+            });
+        });
+        self.status_provider.task = Some(task);
+    }
+
+    pub(crate) fn finish_status_provider_refresh(
+        &mut self,
+        thread_id: ThreadId,
+        request_id: u64,
+        result: StatusProviderRunResult,
+    ) -> bool {
+        if self.thread_id != Some(thread_id)
+            || self.status_provider.task.is_none()
+            || self.status_provider.request_id.wrapping_sub(1) != request_id
+        {
+            return false;
+        }
+
+        self.status_provider.task.take();
+        self.bottom_pane.set_status_provider_lines(result.lines);
+        if self.status_provider.refresh_pending {
+            self.status_provider.refresh_pending = false;
+            self.status_provider.next_refresh_at = Some(Instant::now());
+            self.refresh_status_provider_if_due();
+        } else if let Some(config) = self.status_provider.config.as_ref() {
+            self.status_provider.next_refresh_at =
+                Instant::now().checked_add(config.refresh_interval);
+            self.frame_requester
+                .schedule_frame_in(config.refresh_interval);
+        }
+        true
+    }
+}
