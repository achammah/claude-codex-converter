+#[tokio::test]
+async fn timed_out_output_join_retains_handle_for_cancellation() {
+    struct PendingReader(std::sync::Arc<std::sync::atomic::AtomicBool>);
+
+    impl AsyncRead for PendingReader {
+        fn poll_read(
+            self: std::pin::Pin<&mut Self>,
+            _cx: &mut std::task::Context<'_>,
+            _buf: &mut tokio::io::ReadBuf<'_>,
+        ) -> std::task::Poll<std::io::Result<()>> {
+            std::task::Poll::Pending
+        }
+    }
+
+    impl Drop for PendingReader {
+        fn drop(&mut self) {
+            self.0.store(true, std::sync::atomic::Ordering::SeqCst);
+        }
+    }
+
+    let dropped = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let mut task = tokio::spawn(read_capped(Some(PendingReader(dropped.clone())), 1));
+    let outcome =
+        tokio::time::timeout(Duration::from_millis(10), join_capped_output(&mut task)).await;
+
+    assert!(outcome.is_err());
+    assert!(!task.is_finished());
+    task.abort();
+    let _ = task.await;
+    assert!(dropped.load(std::sync::atomic::Ordering::SeqCst));
+}
