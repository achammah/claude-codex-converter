+
+    /// Maximum wall-clock duration of one refresh in milliseconds.
+    #[serde(default = "default_status_provider_timeout_ms")]
+    #[schemars(range(min = 50, max = 60_000))]
+    pub timeout_ms: u64,
+
+    /// Maximum number of provider rows rendered above the native footer.
+    #[serde(default = "default_status_provider_max_lines")]
+    #[schemars(range(min = 1, max = 4))]
+    pub max_lines: usize,
+
+    /// Terminal styling accepted from provider output.
+    #[serde(default)]
+    pub ansi: TuiStatusProviderAnsi,
+}
