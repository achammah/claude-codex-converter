+#[tokio::test]
+async fn status_provider_rows_render_above_the_unchanged_native_footer() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let width = 80;
+    let baseline_height = chat.desired_height(width);
+    let mut baseline_terminal =
+        ratatui::Terminal::new(TestBackend::new(width, baseline_height)).expect("terminal");
+    baseline_terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("render baseline");
+    let baseline = normalized_backend_snapshot(baseline_terminal.backend());
+    let baseline_footer = baseline
+        .lines()
+        .rfind(|line| !line.trim().is_empty())
+        .expect("native footer row")
+        .trim()
+        .to_string();
+
+    chat.bottom_pane.set_status_provider_lines(vec![
+        ratatui::text::Line::from("Organization: Nexus"),
+        ratatui::text::Line::from("Board: Native status"),
+    ]);
+    let provider_height = chat.desired_height(width);
+    let mut provider_terminal =
+        ratatui::Terminal::new(TestBackend::new(width, provider_height)).expect("terminal");
+    provider_terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("render provider rows");
+    let rendered = normalized_backend_snapshot(provider_terminal.backend());
+    let rendered_lines = rendered.lines().collect::<Vec<_>>();
+    let organization_row = rendered_lines
+        .iter()
+        .position(|line| line.contains("Organization: Nexus"))
+        .expect("organization row");
+    let board_row = rendered_lines
+        .iter()
+        .position(|line| line.contains("Board: Native status"))
+        .expect("board row");
+    let native_footer_row = rendered_lines
+        .iter()
+        .rposition(|line| line.trim() == baseline_footer)
+        .expect("unchanged native footer");
+
+    assert_eq!(provider_height, baseline_height.saturating_add(2));
+    assert_eq!(board_row, organization_row + 1);
+    assert!(native_footer_row > board_row);
+    insta::assert_snapshot!(
+        format!(
+            "height delta: {}\n{}\n{}\nnative footer preserved: {}",
+            provider_height.saturating_sub(baseline_height),
+            rendered_lines[organization_row].trim_matches([' ', '"']),
+            rendered_lines[board_row].trim_matches([' ', '"']),
+            native_footer_row > board_row,
+        ),
+        @r"
