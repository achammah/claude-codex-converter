+#[test]
+fn config_toml_deserializes_tui_status_provider() {
+    let cfg: ConfigToml = toml::from_str(
+        r#"
+[tui.status_provider]
+command = ["python3", ".cue/scripts/status_line.py", "--native-stdin"]
+refresh_interval_ms = 7500
+timeout_ms = 45000
+max_lines = 4
+ansi = "sgr"
+"#,
+    )
+    .expect("status provider config should deserialize");
+    let provider = cfg
+        .tui
+        .expect("tui config should exist")
+        .status_provider
+        .expect("status provider should exist");
+
+    assert_eq!(
+        provider,
+        TuiStatusProviderConfig {
+            command: vec![
+                "python3".to_string(),
+                ".cue/scripts/status_line.py".to_string(),
+                "--native-stdin".to_string(),
+            ],
+            refresh_interval_ms: 7_500,
+            timeout_ms: 45_000,
+            max_lines: 4,
+            ansi: TuiStatusProviderAnsi::Sgr,
+        }
+    );
+}
