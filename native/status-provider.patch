+#[tokio::test]
+async fn status_provider_only_loads_from_trusted_project_config() -> std::io::Result<()> {
+    for (trust_level, should_load) in [("trusted", true), ("untrusted", false)] {
+        let codex_home = TempDir::new()?;
+        let workspace = TempDir::new()?;
+        let workspace_key = workspace.path().to_string_lossy().replace('\\', "\\\\");
+        std::fs::write(
+            codex_home.path().join(CONFIG_TOML_FILE),
+            format!(
+                r#"
+[projects."{workspace_key}"]
+trust_level = "{trust_level}"
+"#,
+            ),
+        )?;
+        let project_config_dir = workspace.path().join(".codex");
+        std::fs::create_dir_all(&project_config_dir)?;
+        std::fs::write(
+            project_config_dir.join(CONFIG_TOML_FILE),
+            r#"
+[tui.status_provider]
+command = ["project-status"]
+"#,
+        )?;
+
+        let config = ConfigBuilder::without_managed_config_for_tests()
+            .codex_home(codex_home.path().to_path_buf())
+            .harness_overrides(ConfigOverrides {
+                cwd: Some(workspace.path().to_path_buf()),
+                ..Default::default()
+            })
+            .build()
+            .await?;
+
+        assert_eq!(
+            config.tui_status_provider.is_some(),
+            should_load,
+            "unexpected status provider load result for {trust_level} project"
+        );
+    }
+    Ok(())
+}
