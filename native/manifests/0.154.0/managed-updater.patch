+//! Converter-owned update policy. Only installed package metadata grants ownership.
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::io::Read;
+use std::path::{Component, Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+const MAX_MANIFEST: u64 = 65536;
+const MAX_OUTPUT: usize = 65536;
+const CHECK_TIMEOUT: Duration = Duration::from_secs(10);
+const CACHE_SECONDS: u64 = 1200;
+static CHECKING: OnceLock<Mutex<std::collections::HashSet<PathBuf>>> = OnceLock::new();
+
+#[derive(Clone, Debug)]
+pub struct CueUpdater {
+    pub manifest: PathBuf,
+    pub program: PathBuf,
+    sha256: String,
+    manifest_sha256: String,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Declaration {
+    schema_version: u32,
+    program: String,
+    sha256: String,
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Envelope {
+    cue_update: Option<Declaration>,
+    manager: Option<String>,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum UpdateState {
+    Current,
+    UpdateAvailable,
+    NoCompatibleUpdate,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct UpdateCheck {
+    pub state: UpdateState,
+    pub version: String,
+    pub release_id: String,
+    pub installed_release_id: String,
+}
+impl UpdateCheck {
+    pub fn available(&self) -> bool {
+        self.state == UpdateState::UpdateAvailable && self.release_id != self.installed_release_id
+    }
+    pub fn display(&self) -> Option<String> {
+        self.available()
+            .then(|| format!("{} (Cue {})", self.version, self.release_id))
+    }
+}
+
+/// Errors are ownership claims that cannot safely select any stock update route.
+pub fn is_private_package(package: &Path) -> bool {
+    package
+        .file_name()
+        .and_then(|n| n.to_str())
+        .is_some_and(|n| n.starts_with(".cue-codex-runtime-"))
+}
+
+pub fn discover(package: &Path) -> Result<Option<CueUpdater>, String> {
+    std::hint::black_box("CUE_MANAGED_UPDATE_V1");
+    let manifest = package.join("codex-package.json");
+    let metadata = fs::metadata(&manifest)
+        .map_err(|e| format!("cannot inspect installed package manifest: {e}"))?;
+    if !metadata.is_file() || metadata.len() > MAX_MANIFEST {
+        return Err("invalid installed package manifest size/type".into());
+    }
+    let bytes = fs::read(&manifest).map_err(|e| e.to_string())?;
+    let envelope: Envelope = serde_json::from_slice(&bytes)
+        .map_err(|e| format!("invalid installed ownership metadata: {e}"))?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes)
+        .map_err(|e| format!("invalid installed package manifest: {e}"))?;
+    let Some(_raw) = value.get("cueUpdate") else {
+        if envelope.manager.as_deref() == Some("claude-codex-converter")
+            || is_private_package(package)
+        {
+            return Err("converter-owned package is missing cueUpdate".into());
+        }
+        return Ok(None);
+    };
+    let declaration = envelope
+        .cue_update
+        .ok_or("invalid null cueUpdate ownership")?;
+    if declaration.schema_version != 1 {
+        return Err("unsupported cueUpdate schemaVersion".into());
+    }
+    if declaration.sha256.len() != 64 || !declaration.sha256.bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err("invalid updater SHA-256".into());
+    }
+    let relative = Path::new(&declaration.program);
+    if relative.is_absolute()
+        || !relative
+            .components()
+            .all(|c| matches!(c, Component::Normal(_)))
+        || relative.components().next()
+            != Some(Component::Normal(std::ffi::OsStr::new("codex-resources")))
+    {
+        return Err("updater must be package-relative under codex-resources".into());
+    }
+    let root = fs::canonicalize(package).map_err(|e| e.to_string())?;
+    let canonical_manifest = fs::canonicalize(&manifest).map_err(|e| e.to_string())?;
+    if !canonical_manifest.starts_with(&root) {
+        return Err("installed manifest escapes package".into());
+    }
+    let program = fs::canonicalize(root.join(relative))
+        .map_err(|e| format!("declared updater unavailable: {e}"))?;
+    if !program.starts_with(root.join("codex-resources")) {
+        return Err("updater escapes package resources".into());
+    }
+    let updater = CueUpdater {
+        manifest: canonical_manifest,
+        program,
+        sha256: declaration.sha256.to_lowercase(),
+        manifest_sha256: format!("{:x}", Sha256::digest(&bytes)),
+    };
+    updater.verify()?;
+    Ok(Some(updater))
+}
+impl CueUpdater {
+    fn verify(&self) -> Result<(), String> {
+        let stamp = format!(
+            "{:x}",
+            Sha256::digest(fs::read(&self.manifest).map_err(|e| e.to_string())?)
+        );
+        if stamp != self.manifest_sha256 {
+            return Err("installed ownership metadata changed; recheck updater".into());
+        }
+        let metadata = fs::metadata(&self.program).map_err(|e| e.to_string())?;
+        if !metadata.is_file() {
+            return Err("updater is not a regular executable".into());
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            if metadata.permissions().mode() & 0o111 == 0 {
+                return Err("updater is not executable".into());
+            }
+        }
+        let digest = format!(
+            "{:x}",
+            Sha256::digest(fs::read(&self.program).map_err(|e| e.to_string())?)
+        );
+        if digest != self.sha256 {
+            return Err("updater SHA-256 mismatch".into());
+        }
+        Ok(())
+    }
+    pub fn command(&self, verb: &str) -> Result<Command, String> {
+        if !matches!(verb, "check" | "update") {
+            return Err("unsupported updater operation".into());
+        }
+        self.verify()?;
+        let mut cmd = Command::new(&self.program);
+        cmd.arg(verb)
+            .arg("--installation")
+            .arg(&self.manifest)
+            .current_dir(
+                self.manifest
+                    .parent()
+                    .ok_or("manifest has no package directory")?,
+            );
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::CommandExt;
+            cmd.process_group(0);
+        }
+        Ok(cmd)
+    }
+    pub fn check(&self) -> Result<UpdateCheck, String> {
+        self.check_with_timeout(CHECK_TIMEOUT)
+    }
+    fn check_with_timeout(&self, timeout: Duration) -> Result<UpdateCheck, String> {
+        let mut child = self
+            .command("check")?
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|e| e.to_string())?;
+        let (tx, rx) = std::sync::mpsc::channel();
+        let stdout = child.stdout.take().ok_or("missing stdout")?;
+        let stderr = child.stderr.take().ok_or("missing stderr")?;
+        for (is_error, mut pipe) in [
+            (false, Box::new(stdout) as Box<dyn Read + Send>),
+            (true, Box::new(stderr) as Box<dyn Read + Send>),
+        ] {
+            let tx = tx.clone();
+            std::thread::spawn(move || {
+                let mut data = Vec::new();
+                let result = pipe
+                    .by_ref()
+                    .take((MAX_OUTPUT + 1) as u64)
+                    .read_to_end(&mut data);
+                let _ = tx.send((is_error, result.map(|_| data)));
+            });
+        }
+        drop(tx);
+        let deadline = Instant::now() + timeout;
+        let mut outputs = [None, None];
+        let status = loop {
+            while let Ok((is_error, result)) = rx.try_recv() {
+                let data = match result {
+                    Ok(data) => data,
+                    Err(e) => {
+                        stop_child(&mut child);
+                        return Err(e.to_string());
+                    }
+                };
+                if data.len() > MAX_OUTPUT {
+                    stop_child(&mut child);
+                    return Err("updater check output limit exceeded".into());
+                }
+                outputs[usize::from(is_error)] = Some(data);
+            }
+            if let Some(status) = child.try_wait().map_err(|e| e.to_string())? {
+                if outputs.iter().all(Option::is_some) {
+                    break status;
+                }
+            }
+            if Instant::now() >= deadline {
+                stop_child(&mut child);
+                return Err("updater check timed out".into());
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        };
+        let stderr =
+            String::from_utf8_lossy(outputs[1].as_deref().unwrap_or_default()).into_owned();
+        if !status.success() {
+            return Err(format!("updater check failed ({status}): {stderr}"));
+        }
+        if !stderr.is_empty() {
+            eprintln!("Cue updater: {stderr}");
+        }
+        let response: UpdateCheck =
+            serde_json::from_slice(outputs[0].as_deref().unwrap_or_default())
+                .map_err(|e| format!("invalid updater check JSON: {e}; stderr: {stderr}"))?;
+        for value in [
+            &response.version,
+            &response.release_id,
+            &response.installed_release_id,
+        ] {
+            if value.is_empty() || value.len() > 200 || value.chars().any(char::is_control) {
+                return Err("invalid updater response identity".into());
+            }
+        }
+        semver::Version::parse(&response.version)
+            .map_err(|e| format!("invalid updater version: {e}"))?;
+        if response.state == UpdateState::UpdateAvailable
+            && response.release_id == response.installed_release_id
+        {
+            return Err("update_available must identify a different release".into());
+        }
+        Ok(response)
+    }
+}
+fn stop_child(child: &mut std::process::Child) {
+    #[cfg(unix)]
+    unsafe {
+        libc::kill(-(child.id() as i32), libc::SIGKILL);
+    }
+    let _ = child.kill();
+    let _ = child.wait();
+}
+#[derive(Serialize, Deserialize)]
+struct CachedCheck {
+    manifest: PathBuf,
+    launcher_sha256: String,
+    manifest_sha256: String,
+    checked_at: u64,
+    result: UpdateCheck,
+    dismissed: Option<String>,
+}
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+fn read_cache(path: &Path) -> Option<CachedCheck> {
+    serde_json::from_slice(&fs::read(path).ok()?).ok()
+}
+/// Separate cache prevents stock upstream metadata from advertising incompatible updates.
+pub fn cached_upgrade(updater: CueUpdater, home: &Path, popup: bool) -> Option<String> {
+    let file = home.join("cue-version.json");
+    let cached = read_cache(&file).filter(|c| {
+        c.manifest == updater.manifest
+            && c.launcher_sha256 == updater.sha256
+            && c.manifest_sha256 == updater.manifest_sha256
+    });
+    if cached
+        .as_ref()
+        .is_none_or(|c| now().saturating_sub(c.checked_at) >= CACHE_SECONDS)
+    {
+        let active = CHECKING.get_or_init(Default::default);
+        if let Ok(mut active) = active.lock()
+            && active.insert(file.clone())
+        {
+            let file = file.clone();
+            let updater = updater.clone();
+            std::thread::spawn(move || {
+                match updater.check() {
+                    Ok(result) => {
+                        let dismissed = read_cache(&file).and_then(|c| c.dismissed);
+                        let cache = CachedCheck {
+                            manifest: updater.manifest,
+                            launcher_sha256: updater.sha256,
+                            manifest_sha256: updater.manifest_sha256,
+                            checked_at: now(),
+                            result,
+                            dismissed,
+                        };
+                        let write = (|| -> Result<(), String> {
+                            fs::create_dir_all(file.parent().ok_or("cache directory missing")?)
+                                .map_err(|e| e.to_string())?;
+                            fs::write(
+                                &file,
+                                serde_json::to_vec(&cache).map_err(|e| e.to_string())?,
+                            )
+                            .map_err(|e| e.to_string())
+                        })();
+                        if let Err(error) = write {
+                            eprintln!("Cue update cache: {error}");
+                        }
+                    }
+                    Err(error) => eprintln!("Cue update check: {error}"),
+                }
+                if let Some(active) = CHECKING.get()
+                    && let Ok(mut active) = active.lock()
+                {
+                    active.remove(&file);
+                }
+            });
+        }
+    }
+    let cached = cached?;
+    if popup && cached.dismissed.as_deref() == Some(cached.result.release_id.as_str()) {
+        return None;
+    }
+    cached.result.display()
+}
+pub fn dismiss(home: &Path) -> Result<(), String> {
+    let file = home.join("cue-version.json");
+    let Some(mut cache) = read_cache(&file) else {
+        return Ok(());
+    };
+    cache.dismissed = Some(cache.result.release_id.clone());
+    fs::write(file, serde_json::to_vec(&cache).map_err(|e| e.to_string())?)
+        .map_err(|e| e.to_string())
+}
+
