+#[test]
+fn runtime_config_clamps_all_numeric_bounds() {
+    let config = provider_config(
+        Vec::new(),
+        u64::MAX,
+        usize::MAX,
+        TuiStatusProviderAnsi::Strip,
+    );
+    assert_eq!(config.refresh_interval, Duration::from_millis(5_000));
+    assert_eq!(config.timeout, Duration::from_millis(MAX_TIMEOUT_MS));
+    assert_eq!(config.timeout_ms, MAX_TIMEOUT_MS);
+    assert_eq!(config.max_lines, MAX_MAX_LINES);
+
+    let config = RuntimeStatusProviderConfig::from(TuiStatusProviderConfig {
+        command: Vec::new(),
+        refresh_interval_ms: 0,
+        timeout_ms: 0,
+        max_lines: 0,
+        ansi: TuiStatusProviderAnsi::Strip,
+    });
+    assert_eq!(
+        config.refresh_interval,
+        Duration::from_millis(MIN_REFRESH_INTERVAL_MS)
+    );
+    assert_eq!(config.timeout, Duration::from_millis(MIN_TIMEOUT_MS));
+    assert_eq!(config.max_lines, MIN_MAX_LINES);
