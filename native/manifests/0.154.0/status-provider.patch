+//! Bounded asynchronous command provider for project-specific TUI status rows.
+
+use std::io::ErrorKind;
+use std::path::Path;
+use std::process::Stdio;
+use std::time::Duration;
+
+use codex_config::types::TuiStatusProviderAnsi;
+use codex_config::types::TuiStatusProviderConfig;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use tokio::io::AsyncRead;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::process::Child;
+use tokio::process::Command;
+use tokio::task::JoinHandle;
+
+const MIN_REFRESH_INTERVAL_MS: u64 = 250;
+const MAX_REFRESH_INTERVAL_MS: u64 = 60_000;
+const MIN_TIMEOUT_MS: u64 = 50;
+const MAX_TIMEOUT_MS: u64 = 60_000;
+const MIN_MAX_LINES: usize = 1;
+const MAX_MAX_LINES: usize = 4;
+const OUTPUT_BYTES_CAP: usize = 16 * 1024;
+pub(crate) const STATUS_PROVIDER_FEATURE_MARKER: &str = "native-status-provider-v1";
+
+#[derive(Clone, Debug)]
+pub(crate) struct RuntimeStatusProviderConfig {
+    pub(crate) command: Vec<String>,
+    pub(crate) refresh_interval: Duration,
+    pub(crate) timeout: Duration,
+    pub(crate) timeout_ms: u64,
+    pub(crate) max_lines: usize,
+    pub(crate) ansi: TuiStatusProviderAnsi,
+}
+
+impl From<TuiStatusProviderConfig> for RuntimeStatusProviderConfig {
+    fn from(config: TuiStatusProviderConfig) -> Self {
+        let refresh_interval_ms = config
+            .refresh_interval_ms
+            .clamp(MIN_REFRESH_INTERVAL_MS, MAX_REFRESH_INTERVAL_MS);
+        let timeout_ms = config.timeout_ms.clamp(MIN_TIMEOUT_MS, MAX_TIMEOUT_MS);
+        Self {
+            command: config.command,
+            refresh_interval: Duration::from_millis(refresh_interval_ms),
+            timeout: Duration::from_millis(timeout_ms),
+            timeout_ms,
+            max_lines: config.max_lines.clamp(MIN_MAX_LINES, MAX_MAX_LINES),
+            ansi: config.ansi,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct StatusProviderRunResult {
+    pub(crate) lines: Vec<Line<'static>>,
+}
+
+pub(crate) async fn run_status_provider(
+    config: &RuntimeStatusProviderConfig,
+    cwd: &Path,
+    input: &[u8],
+    model: &str,
+    reasoning_effort: Option<&str>,
+) -> StatusProviderRunResult {
+    let Some(program) = config.command.first().filter(|program| !program.is_empty()) else {
+        return diagnostic_result("Status provider command is empty".to_string());
+    };
+    let mut command = Command::new(program);
+    command
+        .args(&config.command[1..])
+        .current_dir(cwd)
+        .env("CODEX_THREAD_ID", context_session_id(input))
+        .env("CODEX_PROJECT_DIR", cwd)
+        .env("CODEX_MODEL", model)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true);
+    if let Some(reasoning_effort) = reasoning_effort {
+        command.env("CODEX_REASONING_EFFORT", reasoning_effort);
+    } else {
+        command.env_remove("CODEX_REASONING_EFFORT");
+    }
+    #[cfg(unix)]
+    command.process_group(0);
+
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(err) => return diagnostic_result(format!("Status provider failed to start: {err}")),
+    };
+    let process_id = child.id();
+    let stdout = child.stdout.take();
+    let stderr = child.stderr.take();
+    let mut process = StatusProviderProcess {
+        child,
+        process_id,
+        stdout_task: Some(tokio::spawn(read_capped(stdout, OUTPUT_BYTES_CAP))),
+        stderr_task: Some(tokio::spawn(read_capped(stderr, OUTPUT_BYTES_CAP))),
+        armed: true,
+    };
+
+    let outcome = tokio::time::timeout(config.timeout, async {
+        if let Some(mut stdin) = process.child.stdin.take()
+            && let Err(err) = stdin.write_all(input).await
+            && err.kind() != ErrorKind::BrokenPipe
+        {
+            return Err(format!("Status provider input failed: {err}"));
+        }
+        let status = process
+            .child
+            .wait()
+            .await
+            .map_err(|err| format!("Status provider wait failed: {err}"))?;
+        process.kill_process_group();
+        let Some(stdout_task) = process.stdout_task.as_mut() else {
+            return Err("Status provider stdout task is missing".to_string());
+        };
+        let Some(stderr_task) = process.stderr_task.as_mut() else {
+            return Err("Status provider stderr task is missing".to_string());
+        };
+        let (stdout, stderr) = tokio::join!(
+            join_capped_output(stdout_task),
+            join_capped_output(stderr_task)
+        );
+        Ok::<_, String>((status, stdout?, stderr?))
+    })
+    .await;
+    let (status, stdout, stderr) = match outcome {
+        Ok(Ok(result)) => {
+            process.disarm();
+            result
+        }
+        Ok(Err(message)) => {
+            process.terminate();
+            return diagnostic_result(message);
+        }
+        Err(_) => {
+            process.terminate();
+            return diagnostic_result(format!(
+                "Status provider timed out after {} ms",
+                config.timeout_ms
+            ));
+        }
+    };
+    if !status.success() {
+        let detail =
+            first_diagnostic_line(&stderr.bytes).or_else(|| first_diagnostic_line(&stdout.bytes));
+        let exit = status
+            .code()
+            .map_or_else(|| "signal".to_string(), |code| code.to_string());
+        let message = detail.map_or_else(
+            || format!("Status provider failed (exit {exit})"),
+            |detail| format!("Status provider failed (exit {exit}): {detail}"),
+        );
+        return diagnostic_result(message);
+    }
+
+    output_result(&stdout, config.max_lines, config.ansi)
+}
+
+fn context_session_id(input: &[u8]) -> String {
+    serde_json::from_slice::<serde_json::Value>(input)
+        .ok()
+        .and_then(|value| value.get("session_id")?.as_str().map(str::to_string))
+        .unwrap_or_default()
+}
+
+struct StatusProviderProcess {
+    child: Child,
+    process_id: Option<u32>,
+    stdout_task: Option<JoinHandle<std::io::Result<CappedOutput>>>,
+    stderr_task: Option<JoinHandle<std::io::Result<CappedOutput>>>,
+    armed: bool,
+}
+
+impl StatusProviderProcess {
+    fn kill_process_group(&mut self) {
+        let Some(process_id) = self.process_id.take() else {
+            return;
+        };
+        #[cfg(all(unix, not(target_os = "macos")))]
+        let _ = codex_utils_pty::process_group::kill_process_group(process_id);
+        #[cfg(target_os = "macos")]
+        let _ = codex_utils_pty::process_group::kill_process_group_with_member_fallback(process_id);
+        #[cfg(not(unix))]
+        let _ = process_id;
+    }
+
+    fn abort_readers(&mut self) {
+        if let Some(task) = self.stdout_task.take() {
+            task.abort();
+        }
+        if let Some(task) = self.stderr_task.take() {
+            task.abort();
+        }
+    }
+
+    fn terminate(&mut self) {
+        self.kill_process_group();
+        let _ = self.child.start_kill();
+        self.abort_readers();
+        self.armed = false;
+    }
+
+    fn disarm(&mut self) {
+        self.process_id = None;
+        self.armed = false;
+    }
+}
+
+impl Drop for StatusProviderProcess {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        self.kill_process_group();
+        let _ = self.child.start_kill();
+        self.abort_readers();
+    }
+}
+
+#[derive(Debug, Default)]
+struct CappedOutput {
+    bytes: Vec<u8>,
+    truncated: bool,
+}
+
+async fn read_capped<R>(reader: Option<R>, cap: usize) -> std::io::Result<CappedOutput>
+where
+    R: AsyncRead + Unpin + Send + 'static,
+{
+    let Some(mut reader) = reader else {
+        return Ok(CappedOutput::default());
+    };
+    let mut output = CappedOutput::default();
+    let mut buffer = [0_u8; 4096];
+    loop {
+        let count = reader.read(&mut buffer).await?;
+        if count == 0 {
+            break;
+        }
+        let remaining = cap.saturating_sub(output.bytes.len());
+        let captured = remaining.min(count);
+        output.bytes.extend_from_slice(&buffer[..captured]);
+        output.truncated |= captured < count;
+    }
+    Ok(output)
+}
+
+async fn join_capped_output(
+    task: &mut JoinHandle<std::io::Result<CappedOutput>>,
+) -> Result<CappedOutput, String> {
+    match task.await {
+        Ok(Ok(output)) => Ok(output),
+        Ok(Err(err)) => Err(format!("Status provider output read failed: {err}")),
+        Err(err) => Err(format!("Status provider output task failed: {err}")),
+    }
+}
+
+fn output_result(
+    output: &CappedOutput,
+    max_lines: usize,
+    ansi: TuiStatusProviderAnsi,
+) -> StatusProviderRunResult {
+    let text = String::from_utf8_lossy(&output.bytes);
+    let preserve_sgr = ansi == TuiStatusProviderAnsi::Sgr;
+    let mut lines = text
+        .lines()
+        .take(max_lines)
+        .map(|line| {
+            let sanitized = sanitize_ansi(line, preserve_sgr);
+            codex_ansi_escape::ansi_escape_line(&sanitized)
+        })
+        .collect::<Vec<_>>();
+    if output.truncated
+        && let Some(last) = lines.last_mut()
+    {
+        last.push_span("…".dim());
+    }
+    StatusProviderRunResult { lines }
+}
+
+pub(crate) fn diagnostic_result(message: String) -> StatusProviderRunResult {
+    StatusProviderRunResult {
+        lines: vec![
+            Line::from(format!(
+                "{STATUS_PROVIDER_FEATURE_MARKER}: {}",
+                sanitize_ansi(&message, /*preserve_sgr*/ false)
+            ))
+            .red(),
+        ],
+    }
+}
+
+fn first_diagnostic_line(bytes: &[u8]) -> Option<String> {
+    let text = String::from_utf8_lossy(bytes);
+    let line = text.lines().find(|line| !line.trim().is_empty())?;
+    let line = sanitize_ansi(line, /*preserve_sgr*/ false);
+    Some(line.chars().take(240).collect())
+}
+
+/// Removes terminal control sequences while optionally preserving valid CSI SGR sequences.
+fn sanitize_ansi(input: &str, preserve_sgr: bool) -> String {
+    let bytes = input.as_bytes();
+    let mut output = String::with_capacity(input.len());
+    let mut index = 0;
+    while index < bytes.len() {
+        if bytes[index] == 0x1b {
+            let start = index;
+            index += 1;
+            if bytes.get(index) == Some(&b'[') {
+                index += 1;
+                let params_start = index;
+                while index < bytes.len() && !(0x40..=0x7e).contains(&bytes[index]) {
+                    index += 1;
+                }
+                if index < bytes.len() {
+                    let final_byte = bytes[index];
+                    let params = &bytes[params_start..index];
+                    index += 1;
+                    let valid_params = params
+                        .iter()
+                        .all(|byte| byte.is_ascii_digit() || matches!(byte, b';' | b':'));
+                    if preserve_sgr && final_byte == b'm' && valid_params {
+                        output.push_str(&input[start..index]);
+                    }
+                }
+                continue;
+            }
+            if bytes.get(index) == Some(&b']') {
+                index += 1;
+                while index < bytes.len() {
+                    if bytes[index] == 0x07 {
+                        index += 1;
+                        break;
+                    }
+                    if bytes[index] == 0x1b && bytes.get(index + 1) == Some(&b'\\') {
+                        index += 2;
+                        break;
+                    }
+                    index += 1;
+                }
+                continue;
+            }
+            if let Some(ch) = input[index..].chars().next() {
+                index += ch.len_utf8();
+            }
+            continue;
+        }
+
+        let Some(ch) = input[index..].chars().next() else {
+            break;
+        };
+        index += ch.len_utf8();
+        if ch == '\t' {
+            output.push_str("    ");
+        } else if !ch.is_control() {
+            output.push(ch);
+        }
+    }
+    output
+}
