+#[cfg(unix)]
+#[tokio::test]
+async fn aborting_provider_refresh_kills_its_process_group() {
+    let cwd = tempfile::tempdir().expect("tempdir");
+    let pid_file = cwd.path().join("child.pid");
+    let config = provider_config(
+        vec![
+            "/bin/sh".to_string(),
+            "-c".to_string(),
+            "sleep 5 & echo $! > \"$1\"; wait".to_string(),
+            "status-provider-test".to_string(),
+            pid_file.display().to_string(),
+        ],
+        5_000,
+        2,
+        TuiStatusProviderAnsi::Strip,
+    );
+    let cwd_path = cwd.path().to_path_buf();
+    let task = tokio::spawn(async move {
+        run_status_provider(&config, &cwd_path, b"{}", "gpt-test", None).await
+    });
+
+    let child_pid = loop {
+        if let Ok(contents) = std::fs::read_to_string(&pid_file)
+            && let Ok(pid) = contents.trim().parse::<u32>()
+        {
+            break pid;
+        }
+        assert!(
+            !task.is_finished(),
+            "provider exited before recording child pid"
+        );
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    };
+    task.abort();
+    let _ = task.await;
+
+    let child_gone = async {
+        loop {
+            let alive = std::process::Command::new("/bin/kill")
+                .args(["-0", &child_pid.to_string()])
+                .status()
+                .is_ok_and(|status| status.success());
+            if !alive {
+                break true;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    };
+    assert!(
+        tokio::time::timeout(Duration::from_secs(1), child_gone)
+            .await
+            .unwrap_or(false),
+        "provider child {child_pid} survived task cancellation"
+    );
+}

