+use super::*;
+use std::time::Instant;
+
+fn provider_config(
+    command: Vec<String>,
+    timeout_ms: u64,
+    max_lines: usize,
+    ansi: TuiStatusProviderAnsi,
+) -> RuntimeStatusProviderConfig {
+    RuntimeStatusProviderConfig::from(TuiStatusProviderConfig {
