+mod tests {
+    use super::*;
+    use crate::app_event::AppEvent;
+    use tokio::sync::mpsc::{UnboundedReceiver, unbounded_channel};
+    fn fixture(
+        multi: bool,
+        no_options: bool,
+    ) -> (McpServerElicitationOverlay, UnboundedReceiver<AppEvent>) {
+        let (tx, rx) = unbounded_channel();
+        let mut properties = serde_json::json!({"q0": {"type":"string","title":"Destination","description":"Where should this run?"}});
+        let mut row = serde_json::json!({"id":"q0","multiSelect":multi});
+        if !no_options {
+            row["customField"] = "q0_other".into();
+            properties["q0_other"] = serde_json::json!({"type":"string","title":"Other"});
+            if multi {
+                properties["q0"]["type"] = "array".into();
+                properties["q0"]["items"] =
+                    serde_json::json!({"type":"string","enum":["Local","Cloud"]});
+            } else {
+                properties["q0"]["enum"] = serde_json::json!(["Local", "Cloud"]);
+            }
+        }
+        let request = McpServerElicitationFormRequest::from_parts(
+            ThreadId::default(),
+            "questions".to_owned(),
+            AppServerRequestId::String("form1".to_owned()),
+            Some(&serde_json::json!({"io.cue/questions":{"version":1,"questions":[row]}})),
+            "Choose a destination".to_owned(),
+            serde_json::json!({"type":"object","properties":properties}),
+        )
+        .unwrap();
+        (
+            McpServerElicitationOverlay::new(request, AppEventSender::new(tx), true, false, true),
+            rx,
+        )
+    }
+    fn key(overlay: &mut McpServerElicitationOverlay, code: KeyCode) {
+        overlay.handle_key_event(KeyEvent::new(code, KeyModifiers::NONE));
+    }
+    fn typed(overlay: &mut McpServerElicitationOverlay, text: &str) {
+        for ch in text.chars() {
+            key(overlay, KeyCode::Char(ch));
+        }
+    }
+    fn result(rx: &mut UnboundedReceiver<AppEvent>) -> (McpServerElicitationAction, Option<Value>) {
+        while let Ok(event) = rx.try_recv() {
+            if let AppEvent::SubmitThreadOp {
+                op:
+                    Op::ResolveElicitation {
+                        decision,
+                        content,
+                        meta,
+                        ..
+                    },
+                ..
+            } = event
+            {
+                if decision == McpServerElicitationAction::Accept {
+                    assert_eq!(
+                        meta,
+                        Some(serde_json::json!({"io.cue/questions":{"version":1}}))
+                    );
+                }
+                return (decision, content);
+            }
+        }
+        panic!("no elicitation response")
+    }
+    fn screen(overlay: &McpServerElicitationOverlay, width: u16, height: u16) -> String {
+        let area = Rect::new(0, 0, width, height);
+        let mut buf = Buffer::empty(area);
+        overlay.render(area, &mut buf);
+        (0..height)
+            .map(|y| {
+                (0..width)
+                    .map(|x| buf[(x, y)].symbol())
+                    .collect::<String>()
+                    .trim_end()
+                    .to_owned()
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+    #[test]
+    fn cue_single_custom_is_alternative_and_visible() {
+        let (mut overlay, mut rx) = fixture(false, false);
+        let initial = screen(&overlay, 80, 16);
+        assert!(
+            initial.contains("Local")
+                && initial.contains("Cloud")
+                && initial.contains("Other: type your own answer")
+        );
+        insta::assert_snapshot!("cue_question_single", initial);
+        key(&mut overlay, KeyCode::Char(' '));
+        typed(&mut overlay, "On premises");
+        assert!(overlay.answers[0].chosen.is_empty());
+        let edited = screen(&overlay, 80, 16);
+        assert!(edited.contains("› Other:") && edited.contains("On premises"));
+        insta::assert_snapshot!("cue_question_single_custom", edited);
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(
+            result(&mut rx),
+            (
+                McpServerElicitationAction::Accept,
+                Some(serde_json::json!({"q0_other":"On premises"}))
+            )
+        );
+    }
+    #[test]
+    fn cue_single_deliberate_selection() {
+        let (mut overlay, mut rx) = fixture(false, false);
+        assert!(!overlay.done);
+        key(&mut overlay, KeyCode::Down);
+        key(&mut overlay, KeyCode::Char(' '));
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(result(&mut rx).1, Some(serde_json::json!({"q0":"Cloud"})));
+    }
+    #[test]
+    fn cue_multi_choices_and_custom_share_question() {
+        let (mut overlay, mut rx) = fixture(true, false);
+        key(&mut overlay, KeyCode::Char(' '));
+        key(&mut overlay, KeyCode::Down);
+        key(&mut overlay, KeyCode::Char(' '));
+        typed(&mut overlay, "Edge");
+        let rendered = screen(&overlay, 80, 16);
+        assert!(
+            rendered.contains("[x] Local")
+                && rendered.contains("[x] Cloud")
+                && rendered.contains("Edge")
+        );
+        insta::assert_snapshot!("cue_question_multi_custom", rendered);
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(
+            result(&mut rx).1,
+            Some(serde_json::json!({"q0":["Local","Cloud"],"q0_other":"Edge"}))
+        );
+    }
+    #[test]
+    fn cue_text_only_and_narrow_render() {
+        let (mut overlay, mut rx) = fixture(false, true);
+        typed(&mut overlay, "A custom destination");
+        insta::assert_snapshot!("cue_question_text_narrow", screen(&overlay, 40, 14));
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(
+            result(&mut rx).1,
+            Some(serde_json::json!({"q0":"A custom destination"}))
+        );
+    }
+    #[test]
+    fn cue_cancel_decline_never_submit_drafts() {
+        for (code, modifiers, expected) in [
+            (
+                KeyCode::Esc,
+                KeyModifiers::NONE,
+                McpServerElicitationAction::Cancel,
+            ),
+            (
+                KeyCode::Char('d'),
+                KeyModifiers::CONTROL,
+                McpServerElicitationAction::Decline,
+            ),
+        ] {
+            let (mut overlay, mut rx) = fixture(true, false);
+            key(&mut overlay, KeyCode::Char(' '));
+            typed(&mut overlay, "Unsubmitted");
+            overlay.handle_key_event(KeyEvent::new(code, modifiers));
+            assert_eq!(result(&mut rx), (expected, None));
+        }
+    }
+    #[test]
+    fn cue_blank_custom_enter_never_selects_highlight() {
+        let (mut overlay, _rx) = fixture(false, false);
+        key(&mut overlay, KeyCode::Tab);
+        key(&mut overlay, KeyCode::Enter);
+        assert!(!overlay.done);
+        assert!(overlay.validation_error.is_some());
+    }
+    #[test]
+    fn cue_enter_on_choice_is_deliberate_acceptance() {
+        let (mut overlay, mut rx) = fixture(false, false);
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(result(&mut rx).1, Some(serde_json::json!({"q0":"Local"})));
+    }
+    #[test]
+    fn cue_paste_replaces_single_selection() {
+        let (mut overlay, mut rx) = fixture(false, false);
+        key(&mut overlay, KeyCode::Char(' '));
+        assert!(overlay.handle_paste("Pasted destination".to_owned()));
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(
+            result(&mut rx).1,
+            Some(serde_json::json!({"q0_other":"Pasted destination"}))
+        );
+    }
+    #[test]
+    fn cue_long_options_scroll_but_custom_stays_visible() {
+        let (mut overlay, _rx) = fixture(true, false);
+        let McpServerElicitationFieldInput::CueQuestion { options, .. } =
+            &mut overlay.request.fields[0].input
+        else {
+            panic!("cue question");
+        };
+        *options = (0..20).map(|i| McpServerElicitationOption { label: format!("Destination {i}: a long descriptive label that wraps across the available terminal width"), description: Some("An explanation of the selected destination and its operational constraints".to_owned()), value: Value::String(i.to_string()) }).collect();
+        let mut next = overlay.request.fields[0].clone();
+        next.id = "q1".to_owned();
+        overlay.request.fields.push(next);
+        overlay.reset_for_request();
+        overlay.restore_current_draft();
+        for _ in 0..19 {
+            key(&mut overlay, KeyCode::Down);
+        }
+        let rendered = screen(&overlay, 80, 20);
+        assert!(rendered.contains("Question 1/2"));
+        assert!(rendered.contains("Other: type your own answer"));
+        assert!(rendered.contains("Destination 19"));
+        insta::assert_snapshot!("cue_question_long_options", rendered);
+    }
+    #[test]
+    fn cue_legacy_layout_is_negative_control_for_inline_contract() {
+        let (tx, _rx) = unbounded_channel();
+        let request = McpServerElicitationFormRequest::from_parts(ThreadId::default(), "legacy".to_owned(), AppServerRequestId::String("legacy".to_owned()), None, "Choose a destination".to_owned(), serde_json::json!({"type":"object","properties":{"q0":{"type":"string","enum":["Local","Cloud"]},"q0_other":{"type":"string"}}})).unwrap();
+        let overlay =
+            McpServerElicitationOverlay::new(request, AppEventSender::new(tx), true, false, true);
+        let legacy = screen(&overlay, 80, 16);
+        insta::assert_snapshot!("cue_question_legacy_negative_control", legacy);
+        // The same-screen requirement must reject the stock separate-field layout.
+        assert!(
+            std::panic::catch_unwind(|| {
+                assert!(legacy.contains("Local") && legacy.contains("Other: type your own answer"));
+            })
+            .is_err()
+        );
+        let (native, _) = fixture(false, false);
+        let inline = screen(&native, 80, 16);
+        assert!(inline.contains("Local") && inline.contains("Other: type your own answer"));
+    }
+    #[test]
+    fn cue_return_to_choices_replaces_custom_answer() {
+        let (mut overlay, mut rx) = fixture(false, false);
+        typed(&mut overlay, "Custom draft");
+        key(&mut overlay, KeyCode::Tab);
+        key(&mut overlay, KeyCode::Down);
+        key(&mut overlay, KeyCode::Enter);
+        assert_eq!(result(&mut rx).1, Some(serde_json::json!({"q0":"Cloud"})));
+    }
+    #[test]
+    fn cue_malformed_hint_does_not_drop_fields() {
+        let schema = serde_json::json!({"type":"object","properties":{"q0":{"type":"string"},"unmarked":{"type":"string"}}});
+        let meta = serde_json::json!({"io.cue/questions":{"version":1,"questions":[{"id":"q0","multiSelect":false}]}});
+        assert!(parse(&schema, &meta).is_none());
+    }
+}
+
+#[cfg(test)]
+mod regression_tests {
+    use super::*;
+    #[test]
+    fn cue_unknown_hint_preserves_ordinary_text_form() {
+        let schema = serde_json::json!({"type":"object","properties":{"name":{"type":"string"}}});
+        let request = McpServerElicitationFormRequest::from_parts(
+            ThreadId::default(),
+            "ordinary".to_owned(),
+            AppServerRequestId::String("1".to_owned()),
+            Some(&serde_json::json!({"io.cue/questions":{"version":99,"questions":[]}})),
+            "Name".to_owned(),
+            schema,
+        )
+        .unwrap();
+        assert!(matches!(
+            request.fields[0].input,
+            McpServerElicitationFieldInput::Text { .. }
+        ));
+    }
+    #[test]
+    fn cue_metadata_does_not_change_approval_choices() {
+        let request = McpServerElicitationFormRequest::from_parts(ThreadId::default(), "approval".to_owned(), AppServerRequestId::String("1".to_owned()), Some(&serde_json::json!({APPROVAL_META_KIND_KEY:APPROVAL_META_KIND_MCP_TOOL_CALL,"io.cue/questions":{"version":1,"questions":[]}})), "Allow?".to_owned(), serde_json::json!({"type":"object","properties":{}})).unwrap();
+        assert_eq!(
+            request.response_mode,
+            McpServerElicitationResponseMode::ApprovalAction
+        );
+        assert!(matches!(
+            request.fields[0].input,
+            McpServerElicitationFieldInput::Select { .. }
+        ));
+    }
+}
