+//! Explicit, versioned question presentation. Ordinary MCP/approval forms never use this path.
+use super::*;
+
+#[used]
+#[unsafe(no_mangle)]
+pub static CUE_QUESTION_UI_V1: [u8; 19] = *b"CUE_QUESTION_UI_V1\0";
+
+pub(super) fn parse(schema: &Value, meta: &Value) -> Option<Vec<McpServerElicitationField>> {
+    // Keep the protocol capability marker observable in the installed executable.
+    std::hint::black_box(&CUE_QUESTION_UI_V1);
+    let hint = meta.get("io.cue/questions")?;
+    if hint.get("version")?.as_u64()? != 1 {
+        return None;
+    }
+    let rows = hint.get("questions")?.as_array()?;
+    if rows.is_empty() {
+        return None;
+    }
+    let properties = schema.get("properties")?.as_object()?;
+    let mut seen = HashSet::new();
+    let mut fields = Vec::new();
+    for row in rows {
+        let id = row.get("id")?.as_str()?;
+        if !seen.insert(id.to_owned()) {
+            return None;
+        }
+        let property = properties.get(id)?;
+        if property.get("format").and_then(Value::as_str) == Some("password") {
+            return None;
+        }
+        let multi = row.get("multiSelect")?.as_bool()?;
+        let custom = match row.get("customField") {
+            Some(value) => Some(value.as_str()?),
+            None => None,
+        };
+        let mut options = Vec::new();
+        if let Some(custom) = custom {
+            if !seen.insert(custom.to_owned()) {
+                return None;
+            }
+            let other = properties.get(custom)?;
+            if other.get("format").and_then(Value::as_str) == Some("password") {
+                return None;
+            }
+            if schema
+                .get("required")
+                .and_then(Value::as_array)
+                .is_some_and(|r| {
+                    r.iter()
+                        .any(|v| v.as_str() == Some(id) || v.as_str() == Some(custom))
+                })
+            {
+                return None;
+            }
+            if other.get("type")?.as_str()? != "string" {
+                return None;
+            }
+            let option_schema = if multi {
+                if property.get("type")?.as_str()? != "array" {
+                    return None;
+                }
+                property.get("items")?
+            } else {
+                property
+            };
+            if option_schema
+                .get("type")
+                .and_then(Value::as_str)
+                .is_some_and(|t| t != "string")
+            {
+                return None;
+            }
+            if let Some(values) = option_schema.get("enum").and_then(Value::as_array) {
+                let names = option_schema.get("enumNames").and_then(Value::as_array);
+                for (idx, value) in values.iter().enumerate() {
+                    let value = value.as_str()?;
+                    options.push(McpServerElicitationOption {
+                        label: names
+                            .and_then(|n| n.get(idx))
+                            .and_then(Value::as_str)
+                            .unwrap_or(value)
+                            .to_owned(),
+                        description: None,
+                        value: Value::String(value.to_owned()),
+                    });
+                }
+            } else {
+                let values = option_schema
+                    .get("oneOf")
+                    .or_else(|| option_schema.get("anyOf"))?
+                    .as_array()?;
+                for value in values {
+                    options.push(McpServerElicitationOption {
+                        label: value.get("title")?.as_str()?.to_owned(),
+                        description: None,
+                        value: Value::String(value.get("const")?.as_str()?.to_owned()),
+                    });
+                }
+            }
+            if options.is_empty() {
+                return None;
+            }
+        } else if multi
+            || property.get("type")?.as_str()? != "string"
+            || property.get("enum").is_some()
+            || property.get("oneOf").is_some()
+        {
+            return None;
+        }
+        fields.push(McpServerElicitationField {
+            id: id.to_owned(),
+            label: property
+                .get("title")
+                .and_then(Value::as_str)
+                .unwrap_or(id)
+                .to_owned(),
+            prompt: property
+                .get("description")
+                .and_then(Value::as_str)
+                .unwrap_or("")
+                .to_owned(),
+            required: true,
+            input: McpServerElicitationFieldInput::CueQuestion {
+                options,
+                multi,
+                custom_field: custom.map(ToOwned::to_owned),
+            },
+        });
+    }
+    // An explicit hint must describe the entire form; never discard an unmarked field.
+    if seen.len() != properties.len() {
+        return None;
+    }
+    Some(fields)
+}
+impl McpServerElicitationOverlay {
+    pub(super) fn is_cue_question(&self) -> bool {
+        matches!(
+            self.current_field().map(|f| &f.input),
+            Some(McpServerElicitationFieldInput::CueQuestion { .. })
+        )
+    }
+    pub(super) fn cue_field_value(&self, idx: usize) -> Option<Value> {
+        let field = self.request.fields.get(idx)?;
+        let answer = self.answers.get(idx)?;
+        if !answer.answer_committed {
+            return None;
+        }
+        let McpServerElicitationFieldInput::CueQuestion { options, multi, .. } = &field.input
+        else {
+            return None;
+        };
+        let text = answer.draft.text_with_pending();
+        if !text.trim().is_empty() {
+            return Some(Value::String(text));
+        }
+        let values: Vec<_> = answer
+            .chosen
+            .iter()
+            .filter_map(|i| options.get(*i).map(|o| o.value.clone()))
+            .collect();
+        if values.is_empty() {
+            None
+        } else if *multi {
+            Some(Value::Array(values))
+        } else {
+            values.into_iter().next()
+        }
+    }
+    pub(super) fn cue_content(&self, content: &mut serde_json::Map<String, Value>) {
+        for (idx, field) in self.request.fields.iter().enumerate() {
+            let McpServerElicitationFieldInput::CueQuestion {
+                options,
+                multi,
+                custom_field,
+            } = &field.input
+            else {
+                continue;
+            };
+            let answer = &self.answers[idx];
+            content.remove(&field.id);
+            if !answer.answer_committed {
+                continue;
+            }
+            let text = answer.draft.text_with_pending();
+            let custom_active = !text.trim().is_empty();
+            if custom_active {
+                content.insert(
+                    custom_field.as_ref().unwrap_or(&field.id).clone(),
+                    Value::String(text),
+                );
+            }
+            if *multi || !custom_active {
+                let values: Vec<_> = options
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, _)| answer.chosen.contains(i))
+                    .map(|(_, o)| o.value.clone())
+                    .collect();
+                if !values.is_empty() {
+                    content.insert(
+                        field.id.clone(),
+                        if *multi {
+                            Value::Array(values)
+                        } else {
+                            values[0].clone()
+                        },
+                    );
+                }
+            }
+        }
+    }
+    pub(super) fn cue_footer(&self) -> Vec<FooterTip> {
+        let mut tips = Vec::new();
+        if !self.current_options().is_empty() {
+            tips.push(FooterTip::new("tab: choices / custom answer"));
+            tips.push(FooterTip::new("space: select"));
+        }
+        tips.push(FooterTip::highlighted("enter: submit answer"));
+        if self.field_count() > 1 {
+            tips.push(FooterTip::new("ctrl+p / ctrl+n: question"));
+        }
+        tips.push(FooterTip::new("ctrl+d: decline | esc: cancel"));
+        tips
+    }
+    pub(super) fn cue_composer_area(&self, area: Rect) -> Rect {
+        let height = MIN_COMPOSER_HEIGHT.min(area.height);
+        Rect {
+            y: area.bottom().saturating_sub(height),
+            height,
+            ..area
+        }
+    }
+    pub(super) fn render_cue_input(&self, area: Rect, buf: &mut Buffer) {
+        if area.is_empty() {
+            return;
+        }
+        let composer_area = self.cue_composer_area(area);
+        let label_y = composer_area.y.saturating_sub(1).max(area.y);
+        let rows_area = Rect {
+            height: label_y.saturating_sub(area.y),
+            ..area
+        };
+        let mut state = self
+            .current_answer()
+            .map(|a| a.selection)
+            .unwrap_or_default();
+        let rows = self.option_rows();
+        state.ensure_visible(rows.len(), rows_area.height as usize);
+        if !rows.is_empty() && !rows_area.is_empty() {
+            render_rows(rows_area, buf, &rows, &state, rows.len(), "");
+        }
+        let focus = self.current_answer().is_some_and(|a| a.custom_focus);
+        let text = if self.current_options().is_empty() {
+            "Your answer"
+        } else {
+            "Other: type your own answer"
+        };
+        Paragraph::new(if focus {
+            Line::from(format!("› {text}")).cyan()
+        } else {
+            Line::from(format!("  {text}"))
+        })
+        .render(
+            Rect {
+                y: label_y,
+                height: 1,
+                ..area
+            },
+            buf,
+        );
+        self.composer.render(composer_area, buf);
+    }
+    pub(super) fn handle_cue_key(&mut self, key: KeyEvent) {
+        if key.kind == KeyEventKind::Release {
+            return;
+        }
+        if key.code == KeyCode::Esc
+            || (key.code == KeyCode::Char('c') && key.modifiers.contains(KeyModifiers::CONTROL))
+        {
+            self.dispatch_cancel();
+            self.advance_queue_or_complete();
+            return;
+        }
+        if key.code == KeyCode::Char('d') && key.modifiers.contains(KeyModifiers::CONTROL) {
+            self.app_event_tx.resolve_elicitation(
+                self.request.thread_id,
+                self.request.server_name.clone(),
+                self.request.request_id.clone(),
+                McpServerElicitationAction::Decline,
+                None,
+                None,
+            );
+            self.advance_queue_or_complete();
+            return;
+        }
+        if key.modifiers.contains(KeyModifiers::CONTROL)
+            && matches!(key.code, KeyCode::Char('p' | 'n'))
+        {
+            self.move_field(key.code == KeyCode::Char('n'));
+            return;
+        }
+        if matches!(key.code, KeyCode::Tab | KeyCode::BackTab) && !self.current_options().is_empty()
+        {
+            self.save_current_draft();
+            if let Some(a) = self.current_answer_mut() {
+                a.custom_focus = !a.custom_focus;
+            }
+            return;
+        }
+        let multi = matches!(
+            self.current_field().map(|f| &f.input),
+            Some(McpServerElicitationFieldInput::CueQuestion { multi: true, .. })
+        );
+        let custom_focus = self.current_answer().is_some_and(|a| a.custom_focus);
+        if !custom_focus && matches!(key.code, KeyCode::Up | KeyCode::Down) {
+            let len = self.options_len();
+            if let Some(a) = self.current_answer_mut() {
+                if key.code == KeyCode::Up {
+                    a.selection.move_up_wrap(len);
+                } else {
+                    a.selection.move_down_wrap(len);
+                }
+            }
+            return;
+        }
+        if !custom_focus && key.code == KeyCode::Char(' ') {
+            let idx = self.selected_option_index();
+            if !multi {
+                self.clear_current_draft();
+            }
+            if let (Some(a), Some(idx)) = (self.current_answer_mut(), idx) {
+                if a.chosen.contains(&idx) {
+                    a.chosen.retain(|i| *i != idx);
+                } else {
+                    if !multi {
+                        a.chosen.clear();
+                    }
+                    a.chosen.push(idx);
+                }
+                a.answer_committed = false;
+            }
+            return;
+        }
+        if key.code == KeyCode::Enter && key.modifiers.is_empty() {
+            if custom_focus
+                && (self.composer.is_in_paste_burst()
+                    || !self.composer.current_text_with_pending().is_empty())
+            {
+                let (result, _) = self.composer.handle_key_event(key);
+                self.handle_composer_input_result(result);
+                return;
+            }
+            if !custom_focus && !multi {
+                self.clear_current_draft();
+            }
+            self.save_current_draft();
+            if let Some(a) = self.current_answer_mut() {
+                // Enter on the choices is an explicit selection. Custom focus never falls back.
+                if !custom_focus && !multi {
+                    a.chosen.clear();
+                    if let Some(idx) = a.selection.selected_idx {
+                        a.chosen.push(idx);
+                    }
+                }
+                a.answer_committed =
+                    !a.chosen.is_empty() || !a.draft.text_with_pending().trim().is_empty();
+            }
+            if !self.is_current_field_answered() {
+                self.validation_error = Some("Choose an option or type your answer.".to_owned());
+                return;
+            }
+            self.validation_error = None;
+            self.go_next_or_submit();
+            return;
+        }
+        if let Some(a) = self.current_answer_mut() {
+            a.custom_focus = true;
+            if !multi {
+                a.chosen.clear();
+            }
+        }
+        let before = self.capture_composer_draft();
+        let (result, _) = self.composer.handle_key_event(key);
+        let changed = before != self.capture_composer_draft();
+        if changed {
+            self.validation_error = None;
+            if let Some(a) = self.current_answer_mut() {
+                if !multi {
+                    a.chosen.clear();
+                }
+                a.answer_committed = false;
+            }
+            self.save_current_draft();
+        }
+        // Alternate composer submit bindings retain the same result contract.
+        self.handle_composer_input_result(result);
+    }
+}
